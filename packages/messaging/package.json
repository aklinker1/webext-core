{
  "name": "@webext-core/messaging",
  "version": "4.0.0",
  "description": "Light weight, type-safe wrapper around the web extension messaging APIs. Supports all browsers (Chrome, Firefox, Safari)",
  "keywords": [
    "browser",
    "browser-extension",
    "chrome",
    "chrome-extension",
    "extension",
    "firefox",
    "message",
    "messaging",
    "safari",
    "web-ext",
    "web-extension",
    "webext"
  ],
  "homepage": "https://github.com/aklinker1/webext-core/tree/main/packages/messaging",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aklinker1/webext-core.git",
    "directory": "packages/messaging"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./page": {
      "types": "./dist/page.d.mts",
      "default": "./dist/page.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "buildc -- tsdown",
    "test": "buildc --deps-only -- bun test",
    "test:coverage": "buildc --deps-only -- bun  test --coverage",
    "check": "bun run build && check",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@aklinker1/zero-serialize-error": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "@webext-core/fake-browser": "workspace:*",
    "publint": "^0.2.11",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/chrome": "*"
  },
  "peerDependenciesMeta": {
    "@types/chrome": {
      "optional": true
    }
  },
  "engines": {
    "node": "*"
  }
}
