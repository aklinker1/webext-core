{
  "name": "@webext-core/storage",
  "version": "1.2.1",
  "description": "A type-safe, localStorage-esk wrapper around the web extension storage APIs. Supports all browsers (Chrome, Firefox, Safari, etc)",
  "keywords": [
    "browser",
    "browser-extension",
    "chrome",
    "chrome-extension",
    "extension",
    "firefox",
    "safari",
    "storage",
    "web-ext",
    "web-extension",
    "webext"
  ],
  "homepage": "https://github.com/aklinker1/webext-core/tree/main/packages/storage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aklinker1/webext-core.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "buildc -- tsdown",
    "test": "buildc --deps-only -- bun test",
    "test:coverage": "buildc --deps-only -- bun test --coverage",
    "check": "bun run build && check",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "@webext-core/fake-browser": "workspace:*",
    "publint": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/chrome": "*"
  },
  "peerDependenciesMeta": {
    "@types/chrome": {
      "optional": true
    }
  },
  "engines": {
    "node": "*"
  }
}
